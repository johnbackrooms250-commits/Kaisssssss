local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Morphs = require(RS:WaitForChild("Morphs"))
local buyEvent = RS:WaitForChild("BuyMorph")
local equipEvent = RS:WaitForChild("EquipMorph")

local player = Players.LocalPlayer
local leaderstats = player:WaitForChild("leaderstats")
local FONT = Enum.Font.Garamond
local DARK = Color3.fromRGB(34, 38, 34)
local EDGE = Color3.fromRGB(90, 96, 90)

local function new(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do
		o[k] = v
	end
	if parent then o.Parent = parent end
	return o
end

local function styled(frame, radius)
	new("UICorner", {CornerRadius = UDim.new(0, radius or 4)}, frame)
	new("UIStroke", {Color = EDGE, Thickness = 1.5}, frame)
	return frame
end

local function fmt(n)
	local units = {"", "K", "M", "B", "T", "Q"}
	local i = 1
	while n >= 1000 and i < #units do
		n /= 1000
		i += 1
	end
	if i == 1 then return tostring(math.floor(n)) end
	return string.format("%.2f%s", n, units[i])
end

local gui = new("ScreenGui", {Name = "ShopGui", ResetOnSpawn = false, DisplayOrder = 20, IgnoreGuiInset = true}, player:WaitForChild("PlayerGui"))
local root = new("Frame", {BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.45, Size = UDim2.new(1, 0, 1, 0), Visible = false, Active = true}, gui)
local window = new("Frame", {BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0), Size = UDim2.new(0, 1000, 0, 600)}, root)
new("UIScale", {Scale = 1}, window)

-- ===== left: preview =====
local previewPanel = styled(new("Frame", {BackgroundColor3 = DARK, Size = UDim2.new(0, 440, 0, 330)}, window), 4)
new("TextLabel", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 34), Text = "Character Preview", Font = FONT, TextSize = 28, TextColor3 = Color3.new(1, 1, 1)}, previewPanel)
local previewVF = new("ViewportFrame", {Position = UDim2.new(0, 8, 0, 38), Size = UDim2.new(1, -16, 1, -46), BackgroundColor3 = Color3.fromRGB(74, 80, 82)}, previewPanel)

local nameLabel = styled(new("TextLabel", {BackgroundColor3 = DARK, Position = UDim2.new(0, 0, 0, 340), Size = UDim2.new(0, 440, 0, 44), Font = FONT, TextSize = 30, TextColor3 = Color3.new(1, 1, 1), Text = ""}, window), 4)
local infoLabel = new("TextLabel", {BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, 388), Size = UDim2.new(0, 440, 0, 26), Font = FONT, TextSize = 20, TextColor3 = Color3.fromRGB(235, 235, 235), Text = ""}, window)
local requireLabel = styled(new("TextLabel", {BackgroundColor3 = DARK, Position = UDim2.new(0, 0, 0, 420), Size = UDim2.new(0, 440, 0, 64), Font = FONT, TextSize = 42, TextColor3 = Color3.new(1, 1, 1), Text = "Require: None"}, window), 4)
local actionBtn = styled(new("TextButton", {Position = UDim2.new(0, 0, 0, 494), Size = UDim2.new(0, 440, 0, 46), Font = FONT, TextSize = 32, TextColor3 = Color3.fromRGB(255, 245, 210), Text = "Equip", BackgroundColor3 = Color3.fromRGB(225, 170, 40)}, window), 4)
local returnBtn = styled(new("TextButton", {Position = UDim2.new(0, 0, 0, 550), Size = UDim2.new(0, 440, 0, 42), Font = FONT, TextSize = 24, TextColor3 = Color3.new(1, 1, 1), Text = "Return to Main Menu", BackgroundColor3 = Color3.fromRGB(165, 35, 35)}, window), 4)

-- ===== right: shop =====
local shopPanel = styled(new("Frame", {BackgroundColor3 = DARK, Position = UDim2.new(0, 460, 0, 0), Size = UDim2.new(0, 540, 0, 592)}, window), 4)
new("TextLabel", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 34), Text = "Character Shop", Font = FONT, TextSize = 28, TextColor3 = Color3.new(1, 1, 1)}, shopPanel)
local header = new("TextLabel", {BackgroundColor3 = Color3.fromRGB(18, 18, 18), Position = UDim2.new(0, 0, 0, 36), Size = UDim2.new(1, 0, 0, 28), Font = FONT, TextSize = 18, TextColor3 = Color3.new(1, 1, 1), Text = ""}, shopPanel)
local grid = new("ScrollingFrame", {BackgroundTransparency = 1, Position = UDim2.new(0, 8, 0, 70), Size = UDim2.new(1, -16, 1, -78), CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 6, BorderSizePixel = 0}, shopPanel)
new("UIGridLayout", {CellSize = UDim2.new(0, 120, 0, 150), CellPadding = UDim2.new(0, 8, 0, 8), SortOrder = Enum.SortOrder.LayoutOrder}, grid)

-- ===== viewport helpers =====
local function setupViewport(vf, id, angle)
	vf.Ambient = Color3.fromRGB(150, 150, 150)
	vf.LightColor = Color3.fromRGB(255, 255, 255)
	vf.LightDirection = Vector3.new(-0.4, -0.7, -1)
	local model = Morphs.Build(id)
	model.Parent = vf
	local cam = Instance.new("Camera")
	cam.FieldOfView = 40
	cam.Parent = vf
	vf.CurrentCamera = cam
	local cf, size = model:GetBoundingBox()
	local dim = math.max(size.X, size.Y, size.Z)
	local dist = dim * 1.75
	cam.CFrame = CFrame.lookAt(cf.Position + Vector3.new(0, size.Y * 0.05, -dist), cf.Position)
	model:PivotTo(CFrame.Angles(0, angle or 0, 0))
	return model
end

local selected = "SpiderCommode"
local previewModel
local spin = 0

local function owned()
	local set = {}
	for id in string.gmatch(player:GetAttribute("Owned") or "", "[^,]+") do
		set[id] = true
	end
	return set
end

local function showPreview(id)
	if previewModel then previewModel:Destroy() end
	for _, c in ipairs(previewVF:GetChildren()) do
		if c:IsA("Camera") then c:Destroy() end
	end
	previewModel = setupViewport(previewVF, id, 0)
end

local function refresh()
	local info = Morphs.ById[selected]
	if not info then return end
	local set = owned()
	local equipped = player:GetAttribute("Morph")
	nameLabel.Text = info.Name
	infoLabel.Text = string.format("Dollars: $%s    HP: %s    Speed: %d    Damage x%.1f", fmt(leaderstats.Dollars.Value), fmt(info.Health), info.Speed, info.Damage)
	requireLabel.Text = "Require: " .. info.Require
	if equipped == info.Id then
		actionBtn.Text = "Equipped"
		actionBtn.BackgroundColor3 = Color3.fromRGB(110, 110, 110)
	elseif set[info.Id] then
		actionBtn.Text = "Equip"
		actionBtn.BackgroundColor3 = Color3.fromRGB(225, 170, 40)
	else
		actionBtn.Text = "Purchase ($" .. fmt(info.Price) .. ")"
		actionBtn.BackgroundColor3 = Color3.fromRGB(45, 175, 60)
	end
	header.Text = string.format("%s        Dollars %s        Kills %s        Gems %s", player.Name, fmt(leaderstats.Dollars.Value), fmt(leaderstats.Kills.Value), fmt(leaderstats.Gems.Value))
end

local function select(id)
	selected = id
	showPreview(id)
	refresh()
end

-- tiles
for i, info in ipairs(Morphs.List) do
	local tile = styled(new("Frame", {BackgroundColor3 = Color3.fromRGB(46, 50, 48), LayoutOrder = i}, grid), 3)
	local vf = new("ViewportFrame", {BackgroundColor3 = Color3.fromRGB(58, 62, 64), Position = UDim2.new(0, 4, 0, 4), Size = UDim2.new(1, -8, 0, 96)}, tile)
	setupViewport(vf, info.Id, math.rad(-25))
	new("TextLabel", {BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, 102), Size = UDim2.new(1, 0, 0, 22), Text = info.Name, Font = FONT, TextSize = 18, TextColor3 = Color3.new(1, 1, 1)}, tile)
	local tag = new("TextLabel", {BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, 124), Size = UDim2.new(1, 0, 0, 20), Text = "", Font = FONT, TextSize = 16, TextColor3 = Color3.fromRGB(255, 220, 90)}, tile)
	tile:SetAttribute("Tag", info.Id)
	local click = new("TextButton", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Text = "", ZIndex = 5}, tile)
	click.MouseButton1Click:Connect(function() select(info.Id) end)
	task.spawn(function()
		while tile.Parent do
			local set = owned()
			if player:GetAttribute("Morph") == info.Id then
				tag.Text = "Equipped"
			elseif set[info.Id] then
				tag.Text = "Owned"
			else
				tag.Text = "$" .. fmt(info.Price)
			end
			task.wait(0.5)
		end
	end)
end

actionBtn.MouseButton1Click:Connect(function()
	local info = Morphs.ById[selected]
	if not info then return end
	local set = owned()
	if player:GetAttribute("Morph") == info.Id then return end
	if set[info.Id] then
		equipEvent:FireServer(info.Id)
	else
		buyEvent:FireServer(info.Id)
	end
end)

returnBtn.MouseButton1Click:Connect(function()
	player:SetAttribute("UI_Shop", false)
end)

player:GetAttributeChangedSignal("UI_Shop"):Connect(function()
	local open = player:GetAttribute("UI_Shop") == true
	root.Visible = open
	if open then
		select(player:GetAttribute("Morph") or "SpiderCommode")
	end
end)
for _, name in ipairs({"Owned", "Morph"}) do
	player:GetAttributeChangedSignal(name):Connect(refresh)
end
leaderstats:WaitForChild("Dollars").Changed:Connect(function()
	if root.Visible then refresh() end
end)

RunService.RenderStepped:Connect(function(dt)
	if root.Visible and previewModel then
		spin += dt * 0.8
		previewModel:PivotTo(CFrame.Angles(0, spin, 0))
	end
end)
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX001277"><Properties><bool name="Disabled">false</bool><string name="Name">Input</string><ProtectedString name="Source"><![CDATA[-- Input (LocalScript): machine gun firing and building tools
local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local RS = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local fireEvent = RS:WaitForChild("FireGun")
local placeEvent = RS:WaitForChild("PlaceBlock")

local FIRE_RATE = 0.1
local lastShot = 0
local mouseDown = false

local function shopOpen()
	return player:GetAttribute("UI_Shop") == true
end

UIS.InputBegan:Connect(function(input, gp)
	if gp or shopOpen() then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		if player:GetAttribute("Slot") == 1 then
			local ray = camera:ViewportPointToRay(input.Position.X, input.Position.Y)
			local params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Exclude
			params.FilterDescendantsInstances = {player.Character, workspace:FindFirstChild("Enemies")}
			local result = workspace:Raycast(ray.Origin, ray.Direction * 400, params)
			if result then
				placeEvent:FireServer(result.Position)
			end
		else
			mouseDown = true
		end
	end
end)

UIS.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		mouseDown = false
	end
end)

local function nearestEnemy(origin, maxDist)
	local enemies = workspace:FindFirstChild("Enemies")
	if not enemies then return nil end
	local best, bestDist = nil, maxDist
	for _, e in ipairs(enemies:GetChildren()) do
		local d = (e:GetPivot().Position - origin).Magnitude
		if d < bestDist then
			best, bestDist = e, d
		end
	end
	return best
end

RunService.RenderStepped:Connect(function()
	local touchFire = player:GetAttribute("Firing") == true
	if not (mouseDown or touchFire) then return end
	if shopOpen() or player:GetAttribute("Slot") ~= 2 then return end
	local now = os.clock()
	if now - lastShot < FIRE_RATE then return end
	lastShot = now

	local enemies = workspace:FindFirstChild("Enemies")
	if not enemies then return end
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	local target
	if touchFire then
		target = nearestEnemy(hrp.Position, 300)
	else
		local mouse = UIS:GetMouseLocation()
		local ray = camera:ViewportPointToRay(mouse.X, mouse.Y)
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = {char}
		local result = workspace:Raycast(ray.Origin, ray.Direction * 700, params)
		if result then
			local model = result.Instance:FindFirstAncestorOfClass("Model")
			if model and model.Parent == enemies then
				target = model
			end
		end
		if not target then
			-- aim assist: closest enemy to the crosshair line
			local best, bestAngle = nil, 0.12
			for _, e in ipairs(enemies:GetChildren()) do
				local to = (e:GetPivot().Position - ray.Origin)
				local angle = math.acos(math.clamp(to.Unit:Dot(ray.Direction.Unit), -1, 1))
				if angle < bestAngle then
					best, bestAngle = e, angle
				end
			end
			target = best
		end
	end
	if target then
		fireEvent:FireServer(target)
	end
end)
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX001278"><Properties><bool name="Disabled">false</bool><string name="Name">CameraFit</string><ProtectedString name="Source"><![CDATA[-- Camera (LocalScript): keep the camera outside big morph bodies
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
player.CameraMaxZoomDistance = 300

RunService.RenderStepped:Connect(function()
	local char = player.Character
	local mm = char and char:FindFirstChild("MorphModel")
	local D = mm and mm:GetAttribute("GroundDrop") or 5
	player.CameraMinZoomDistance = math.clamp(D * 1.7, 8, 70)
end)
]]></ProtectedString></Properties></Item></Item></Item><Item class="StarterGui" referent="RBX001281"><Properties><string name="Name">StarterGui</string></Properties></Item></roblox>