CFrame><Color3uint8 name="Color3uint8">4282535514</Color3uint8><token name="shape">1</token><bool name="Anchored">true</bool><bool name="CanCollide">true</bool><float name="Transparency">0</float></Properties></Item><Item class="Part" referent="RBX001257"><Properties><string name="Name">Windows_3_3_8</string><Vector3 name="size"><X>41.4</X><Y>3.2</Y><Z>76.4</Z></Vector3><CFrame name="CFrame"><X>461.0</X><Y>60.5</Y><Z>461.0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CFrame><Color3uint8 name="Color3uint8">4282535514</Color3uint8><token name="shape">1</token><bool name="Anchored">true</bool><bool name="CanCollide">true</bool><float name="Transparency">0</float></Properties></Item><Item class="Part" referent="RBX001258"><Properties><string name="Name">Windows_3_3_9</string><Vector3 name="size"><X>41.4</X><Y>3.2</Y><Z>76.4</Z></Vector3><CFrame name="CFrame"><X>461.0</X><Y>67.5</Y><Z>461.0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CFrame><Color3uint8 name="Color3uint8">4282535514</Color3uint8><token name="shape">1</token><bool name="Anchored">true</bool><bool name="CanCollide">true</bool><float name="Transparency">0</float></Properties></Item><Item class="Part" referent="RBX001259"><Properties><string name="Name">Windows_3_3_10</string><Vector3 name="size"><X>41.4</X><Y>3.2</Y><Z>76.4</Z></Vector3><CFrame name="CFrame"><X>461.0</X><Y>74.5</Y><Z>461.0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CFrame><Color3uint8 name="Color3uint8">4282535514</Color3uint8><token name="shape">1</token><bool name="Anchored">true</bool><bool name="CanCollide">true</bool><float name="Transparency">0</float></Properties></Item><Item class="Part" referent="RBX001260"><Properties><string name="Name">Windows_3_3_11</string><Vector3 name="size"><X>41.4</X><Y>3.2</Y><Z>76.4</Z></Vector3><CFrame name="CFrame"><X>461.0</X><Y>81.5</Y><Z>461.0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CFrame><Color3uint8 name="Color3uint8">4282535514</Color3uint8><token name="shape">1</token><bool name="Anchored">true</bool><bool name="CanCollide">true</bool><float name="Transparency">0</float></Properties></Item><Item class="Part" referent="RBX001261"><Properties><string name="Name">Roof_3_3</string><Vector3 name="size"><X>24.599999999999998</X><Y>1.2</Y><Z>45.6</Z></Vector3><CFrame name="CFrame"><X>461.0</X><Y>88.1</Y><Z>461.0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CFrame><Color3uint8 name="Color3uint8">4284111970</Color3uint8><token name="shape">1</token><bool name="Anchored">true</bool><bool name="CanCollide">true</bool><float name="Transparency">0</float></Properties></Item></Item><Item class="Lighting" referent="RBX001282"><Properties><string name="Name">Lighting</string><float name="ClockTime">14</float><float name="Brightness">2.5</float></Properties></Item><Item class="ServerScriptService" referent="RBX001264"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX001263"><Properties><bool name="Disabled">false</bool><string name="Name">GameServer</string><ProtectedString name="Source"><![CDATA[-- GameServer part A: services, config, player data, morph application
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local RS = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")

local Morphs = require(RS:WaitForChild("Morphs"))
local Remotes = {}
for _, n in ipairs({"FireGun", "Ability", "BuyMorph", "EquipMorph", "PlaceBlock", "Popup", "Notify"}) do
	Remotes[n] = RS:WaitForChild(n)
end

local CONFIG = {
	StartDollars = 2000,
	PassiveIncome = 10,
	MaxEnemies = 24,
	SpawnInterval = 2.2,
	GunDamage = 20,
	FireCooldown = 0.09,
	MaxRange = 450,
	QuadCooldown = 18,
	QuadDamage = 450,
	TitanCooldown = 10,
	TitanDamage = 300,
	TitanRadius = 48,
	MaxBlocks = 10,
	RoadSpacing = 130,
}

Players.RespawnTime = 4

local enemyFolder = Instance.new("Folder")
enemyFolder.Name = "Enemies"
enemyFolder.Parent = workspace
local buildFolder = Instance.new("Folder")
buildFolder.Name = "Builds"
buildFolder.Parent = workspace

local function now()
	return workspace:GetServerTimeNow()
end

local function inCombat(plr)
	plr:SetAttribute("CombatUntil", now() + 5)
end

local function notify(plr, text)
	Remotes.Notify:FireClient(plr, text)
end

local function ownedSet(plr)
	local set = {}
	for id in string.gmatch(plr:GetAttribute("Owned") or "", "[^,]+") do
		set[id] = true
	end
	return set
end

local function saveOwned(plr, set)
	local list = {}
	for id in pairs(set) do
		table.insert(list, id)
	end
	table.sort(list)
	plr:SetAttribute("Owned", table.concat(list, ","))
end

local function xpNeeded(level)
	return 100 * level
end

local function addXP(plr, amount)
	local xp = (plr:GetAttribute("XP") or 0) + amount
	local lvl = plr:GetAttribute("Level") or 1
	local leveled = false
	while xp >= xpNeeded(lvl) do
		xp -= xpNeeded(lvl)
		lvl += 1
		leveled = true
	end
	plr:SetAttribute("XP", xp)
	plr:SetAttribute("Level", lvl)
	if leveled then
		notify(plr, "Level up! You are now level " .. lvl)
	end
end

-- ===== hide the default avatar and wear the morph =====
local function hideInst(char, inst)
	if inst:FindFirstAncestor("MorphModel") then return end
	if inst:IsA("BasePart") and inst.Name ~= "HumanoidRootPart" then
		inst.Transparency = 1
	elseif inst:IsA("Decal") then
		inst.Transparency = 1
	end
end

local function applyMorph(plr, id)
	local char = plr.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local info = Morphs.ById[id]
	if not (hum and hrp and info) then return end

	local old = char:FindFirstChild("MorphModel")
	if old then old:Destroy() end

	local model = Morphs.Build(id)
	model.Name = "MorphModel"
	local D = model:GetAttribute("GroundDrop")

	local groundBelow
	if hum.RigType == Enum.HumanoidRigType.R15 then
		hum.HipHeight = D - hrp.Size.Y / 2
		groundBelow = hum.HipHeight + hrp.Size.Y / 2
	else
		groundBelow = 3
	end

	local levelBonus = 1 + 0.1 * ((plr:GetAttribute("Level") or 1) - 1)
	local hp = math.floor(info.Health * levelBonus)
	hum.MaxHealth = hp
	hum.Health = hp
	hum.WalkSpeed = info.Speed

	model:PivotTo(hrp.CFrame * CFrame.new(0, D - groundBelow, 0))
	local wc = Instance.new("WeldConstraint")
	wc.Part0 = hrp
	wc.Part1 = model.PrimaryPart
	wc.Parent = model.PrimaryPart
	model.Parent = char
	CollectionService:AddTag(model, "Walker")
	plr:SetAttribute("Morph", id)
end

local function onCharacter(plr, char)
	local hum = char:WaitForChild("Humanoid", 10)
	local hrp = char:WaitForChild("HumanoidRootPart", 10)
	if not hum or not hrp then return end
	for _, d in ipairs(char:GetDescendants()) do
		hideInst(char, d)
	end
	char.DescendantAdded:Connect(function(d)
		hideInst(char, d)
	end)
	task.wait(0.5)
	applyMorph(plr, plr:GetAttribute("Morph"))
	hum.Died:Connect(function()
		notify(plr, "Notification: Returning to menu in 4")
	end)
end

local function setupPlayer(plr)
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	ls.Parent = plr
	for _, name in ipairs({"Dollars", "Kills", "Gems"}) do
		local v = Instance.new("IntValue")
		v.Name = name
		v.Value = (name == "Dollars") and CONFIG.StartDollars or 0
		v.Parent = ls
	end
	plr:SetAttribute("Level", 1)
	plr:SetAttribute("XP", 0)
	plr:SetAttribute("Morph", "SpiderCommode")
	plr:SetAttribute("Owned", "LensAgent,SpiderCommode")
	plr:SetAttribute("CombatUntil", 0)
	plr:SetAttribute("CD_Quad", 0)
	plr:SetAttribute("CD_Titan", 0)
	plr.CharacterAdded:Connect(function(char)
		onCharacter(plr, char)
	end)
	if plr.Character then
		task.spawn(onCharacter, plr, plr.Character)
	end
end

Players.PlayerAdded:Connect(setupPlayer)
for _, plr in ipairs(Players:GetPlayers()) do
	setupPlayer(plr)
end

-- ===== shop =====
Remotes.BuyMorph.OnServerEvent:Connect(function(plr, id)
	local info = Morphs.ById[tostring(id)]
	local ls = plr:FindFirstChild("leaderstats")
	if not info or not ls then return end
	local owned = ownedSet(plr)
	if owned[info.Id] then return end
	if (plr:GetAttribute("Level") or 1) < info.Level then
		notify(plr, "You need level " .. info.Level .. " for " .. info.Name)
		return
	end
	if ls.Dollars.Value < info.Price then
		notify(plr, "Not enough dollars for " .. info.Name)
		return
	end
	ls.Dollars.Value -= info.Price
	owned[info.Id] = true
	saveOwned(plr, owned)
	notify(plr, "Purchased " .. info.Name)
end)

Remotes.EquipMorph.OnServerEvent:Connect(function(plr, id)
	local info = Morphs.ById[tostring(id)]
	if not info then return end
	if not ownedSet(plr)[info.Id] then return end
	plr:SetAttribute("Morph", info.Id)
	applyMorph(plr, info.Id)
	notify(plr, "Equipped " .. info.Name)
end)


-- GameServer part B: effects, damage, machine gun, abilities, building tools
local enemyBars = {} -- enemy model -> fill Frame

local function popup(plr, pos, text, color)
	Remotes.Popup:FireClient(plr, pos, text, color)
end

local function tracer(from, to, color, width)
	local dist = (to - from).Magnitude
	if dist < 0.1 then return end
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Material = Enum.Material.Neon
	p.Color = color
	p.Size = Vector3.new(width, width, dist)
	p.CFrame = CFrame.lookAt(from, to) * CFrame.new(0, 0, -dist / 2)
	p.Parent = workspace
	Debris:AddItem(p, 0.12)
end

local function boom(pos, size, color)
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Ball
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Material = Enum.Material.Neon
	p.Color = color
	p.Size = Vector3.new(2, 2, 2)
	p.Position = pos
	p.Parent = workspace
	TweenService:Create(p, TweenInfo.new(0.45), {Size = Vector3.new(size, size, size), Transparency = 1}):Play()
	Debris:AddItem(p, 0.6)
end

local function muzzlePos(plr)
	local char = plr.Character
	if not char then return nil end
	local model = char:FindFirstChild("MorphModel")
	local m = model and model:FindFirstChild("Muzzle", true)
	if m then return m.WorldPosition end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	return hrp and hrp.Position
end

local function damageMult(plr)
	local info = Morphs.ById[plr:GetAttribute("Morph") or ""]
	local lvl = plr:GetAttribute("Level") or 1
	return (info and info.Damage or 1) * (1 + 0.1 * (lvl - 1))
end

local function damageEnemy(enemy, amount, plr)
	local hp = enemy:GetAttribute("Health")
	if not hp or hp <= 0 then return end
	hp -= amount
	enemy:SetAttribute("Health", hp)
	inCombat(plr)

	local pos = enemy:GetPivot().Position + Vector3.new(0, enemy:GetAttribute("Height") or 8, 0)
	popup(plr, pos, "-" .. math.floor(amount), Color3.fromRGB(255, 255, 255))

	local fill = enemyBars[enemy]
	if fill then
		fill.Size = UDim2.new(math.clamp(hp / enemy:GetAttribute("MaxHealth"), 0, 1), 0, 1, 0)
	end

	if hp <= 0 then
		local reward = enemy:GetAttribute("Reward") or 100
		local ls = plr:FindFirstChild("leaderstats")
		if ls then
			ls.Dollars.Value += reward
			ls.Kills.Value += 1
			if math.random() < 0.08 then
				ls.Gems.Value += 1
			end
		end
		addXP(plr, enemy:GetAttribute("XP") or 20)
		popup(plr, pos + Vector3.new(0, 3, 0), "+" .. reward, Color3.fromRGB(255, 220, 60))
		boom(enemy:GetPivot().Position, 18, Color3.fromRGB(255, 150, 40))
		enemyBars[enemy] = nil
		enemy:Destroy()
	end
end

local lastFire = {}

Remotes.FireGun.OnServerEvent:Connect(function(plr, enemy)
	if typeof(enemy) ~= "Instance" or enemy.Parent ~= enemyFolder then return end
	local t = os.clock()
	if lastFire[plr] and t - lastFire[plr] < CONFIG.FireCooldown then return end
	lastFire[plr] = t

	local char = plr.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum or hum.Health <= 0 then return end
	local target = enemy:GetPivot().Position
	if (target - hrp.Position).Magnitude > CONFIG.MaxRange then return end

	local from = muzzlePos(plr) or hrp.Position
	tracer(from, target + Vector3.new(0, (enemy:GetAttribute("Height") or 6) * 0.5, 0), Color3.fromRGB(255, 220, 120), 0.25)
	damageEnemy(enemy, CONFIG.GunDamage * damageMult(plr), plr)
end)

local function nearestEnemies(pos, radius, limit)
	local list = {}
	for _, e in ipairs(enemyFolder:GetChildren()) do
		local d = (e:GetPivot().Position - pos).Magnitude
		if d <= radius then
			table.insert(list, {enemy = e, dist = d})
		end
	end
	table.sort(list, function(a, b) return a.dist < b.dist end)
	local out = {}
	for i = 1, math.min(limit or #list, #list) do
		out[i] = list[i].enemy
	end
	return out
end

Remotes.Ability.OnServerEvent:Connect(function(plr, name)
	local char = plr.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum or hum.Health <= 0 then return end

	if name == "Quad" then
		if now() < (plr:GetAttribute("CD_Quad") or 0) then return end
		local targets = nearestEnemies(hrp.Position, 220, 4)
		if #targets == 0 then
			notify(plr, "No enemies in range")
			return
		end
		plr:SetAttribute("CD_Quad", now() + CONFIG.QuadCooldown)
		local from = hrp.Position + Vector3.new(0, 6, 0)
		for _, e in ipairs(targets) do
			local to = e:GetPivot().Position + Vector3.new(0, (e:GetAttribute("Height") or 6) * 0.5, 0)
			tracer(from, to, Color3.fromRGB(255, 60, 60), 1.4)
			boom(to, 14, Color3.fromRGB(255, 80, 80))
			damageEnemy(e, CONFIG.QuadDamage * damageMult(plr), plr)
		end
	elseif name == "Titan" then
		if now() < (plr:GetAttribute("CD_Titan") or 0) then return end
		plr:SetAttribute("CD_Titan", now() + CONFIG.TitanCooldown)
		local ring = Instance.new("Part")
		ring.Shape = Enum.PartType.Cylinder
		ring.Anchored = true
		ring.CanCollide = false
		ring.CanQuery = false
		ring.CanTouch = false
		ring.Material = Enum.Material.Neon
		ring.Color = Color3.fromRGB(120, 200, 255)
		ring.Size = Vector3.new(1, 4, 4)
		ring.CFrame = CFrame.new(hrp.Position.X, 1, hrp.Position.Z) * CFrame.Angles(0, 0, math.pi / 2)
		ring.Parent = workspace
		local d = CONFIG.TitanRadius * 2
		TweenService:Create(ring, TweenInfo.new(0.5), {Size = Vector3.new(1, d, d), Transparency = 1}):Play()
		Debris:AddItem(ring, 0.7)
		for _, e in ipairs(nearestEnemies(hrp.Position, CONFIG.TitanRadius, nil)) do
			damageEnemy(e, CONFIG.TitanDamage * damageMult(plr), plr)
		end
	end
end)

-- Building tools: place a barrier wall
local placed = {}
Remotes.PlaceBlock.OnServerEvent:Connect(function(plr, pos)
	if typeof(pos) ~= "Vector3" then return end
	local char = plr.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp or (pos - hrp.Position).Magnitude > 160 then return end
	placed[plr] = placed[plr] or {}
	local list = placed[plr]
	if #list >= CONFIG.MaxBlocks then
		local oldest = table.remove(list, 1)
		if oldest then oldest:Destroy() end
	end
	local p = Instance.new("Part")
	p.Name = "Barrier"
	p.Anchored = true
	p.Size = Vector3.new(14, 9, 2)
	p.Color = Color3.fromRGB(60, 140, 255)
	p.Material = Enum.Material.ForceField
	p.CFrame = CFrame.lookAt(Vector3.new(pos.X, 4.5, pos.Z), Vector3.new(hrp.Position.X, 4.5, hrp.Position.Z))
	p.Parent = buildFolder
	table.insert(list, p)
end)

Players.PlayerRemoving:Connect(function(plr)
	lastFire[plr] = nil
	if placed[plr] then
		for _, p in ipairs(placed[plr]) do
			p:Destroy()
		end
		placed[plr] = nil
	end
end)


-- GameServer part C: enemy spawning, AI, passive income
local function alivePlayers()
	local list = {}
	for _, plr in ipairs(Players:GetPlayers()) do
		local char = plr.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hrp and hum and hum.Health > 0 then
			table.insert(list, {plr = plr, char = char, hrp = hrp, hum = hum})
		end
	end
	return list
end

local function totalKills()
	local n = 0
	for _, plr in ipairs(Players:GetPlayers()) do
		local ls = plr:FindFirstChild("leaderstats")
		if ls then n += ls.Kills.Value end
	end
	return n
end

local function addHealthBar(model, height)
	local body = model.PrimaryPart
	local gui = Instance.new("BillboardGui")
	gui.Name = "HealthBar"
	gui.Adornee = body
	gui.Size = UDim2.new(0, 120, 0, 12)
	gui.StudsOffset = Vector3.new(0, height, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 400
	local bg = Instance.new("Frame")
	bg.Size = UDim2.new(1, 0, 1, 0)
	bg.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
	bg.BorderSizePixel = 0
	bg.Parent = gui
	local fill = Instance.new("Frame")
	fill.Size = UDim2.new(1, 0, 1, 0)
	fill.BackgroundColor3 = Color3.fromRGB(220, 40, 40)
	fill.BorderSizePixel = 0
	fill.Parent = bg
	gui.Parent = body
	enemyBars[model] = fill
end

local function spawnEnemy()
	if #enemyFolder:GetChildren() >= CONFIG.MaxEnemies then return end
	local list = alivePlayers()
	if #list == 0 then return end
	local target = list[math.random(#list)]
	local tier = 1 + math.floor(totalKills() / 40)

	local model, kind, scale
	if math.random() < 0.6 then
		kind = "spider"
		scale = 0.8 + math.random() * 0.7
		model = Morphs.BuildEnemy("spider", scale, nil)
	else
		kind = "agent"
		scale = 1 + math.random() * 0.3
		model = Morphs.BuildEnemy("agent", scale, Color3.fromHSV(math.random(), 0.25, 0.28))
	end
	local D = model:GetAttribute("GroundDrop")

	local angle = math.random() * math.pi * 2
	local r = 140 + math.random() * 110
	local p = target.hrp.Position + Vector3.new(math.cos(angle) * r, 0, math.sin(angle) * r)
	if math.random() < 0.5 then
		p = Vector3.new(math.round(p.X / CONFIG.RoadSpacing) * CONFIG.RoadSpacing, 0, p.Z)
	else
		p = Vector3.new(p.X, 0, math.round(p.Z / CONFIG.RoadSpacing) * CONFIG.RoadSpacing)
	end
	p = Vector3.new(math.clamp(p.X, -500, 500), 0, math.clamp(p.Z, -500, 500))

	model:PivotTo(CFrame.new(p.X, D + 0.3, p.Z))
	model.PrimaryPart.Anchored = true

	local hp, dmg, range, speed, reward, xp, cooldown
	if kind == "spider" then
		hp = 140 * scale * scale * tier
		dmg = 22 * scale * (1 + 0.1 * (tier - 1))
		range = 9 * scale
		speed = 15
		reward = math.floor(120 * scale * tier)
		xp = 30
		cooldown = 1
	else
		hp = 80 * scale * tier
		dmg = 12 * (1 + 0.1 * (tier - 1))
		range = 75
		speed = 13
		reward = math.floor(70 * tier)
		xp = 18
		cooldown = 1.3
	end
	model:SetAttribute("Kind", kind)
	model:SetAttribute("Health", hp)
	model:SetAttribute("MaxHealth", hp)
	model:SetAttribute("Damage", dmg)
	model:SetAttribute("Range", range)
	model:SetAttribute("Speed", speed)
	model:SetAttribute("Reward", reward)
	model:SetAttribute("XP", xp)
	model:SetAttribute("Cooldown", cooldown)
	model:SetAttribute("Height", D * 1.1)
	model:SetAttribute("LastAttack", 0)

	CollectionService:AddTag(model, "Walker")
	model.Parent = enemyFolder
	addHealthBar(model, D * 0.55 + 4)
end

task.spawn(function()
	while true do
		spawnEnemy()
		task.wait(CONFIG.SpawnInterval)
	end
end)

task.spawn(function()
	while true do
		task.wait(1)
		for _, plr in ipairs(Players:GetPlayers()) do
			local ls = plr:FindFirstChild("leaderstats")
			if ls then
				ls.Dollars.Value += CONFIG.PassiveIncome
			end
		end
	end
end)

RunService.Heartbeat:Connect(function(dt)
	local players = alivePlayers()
	if #players == 0 then return end
	local t = os.clock()
	for _, enemy in ipairs(enemyFolder:GetChildren()) do
		if enemy.Parent ~= enemyFolder then continue end
		local D = enemy:GetAttribute("Height") and (enemy:GetAttribute("Height") / 1.1) or 8
		local pos = enemy:GetPivot().Position
		local here = Vector3.new(pos.X, 0, pos.Z)

		local best, bestDist = nil, math.huge
		for _, info in ipairs(players) do
			local p = info.hrp.Position
			local d = (Vector3.new(p.X, 0, p.Z) - here).Magnitude
			if d < bestDist then
				best, bestDist = info, d
			end
		end
		if not best then continue end

		local tp = best.hrp.Position
		local target = Vector3.new(tp.X, 0, tp.Z)
		local range = enemy:GetAttribute("Range")
		local stopAt = range * 0.8
		if bestDist > stopAt then
			local dir = (target - here).Unit
			local newPos = here + dir * math.min(enemy:GetAttribute("Speed") * dt, bestDist - stopAt)
			enemy:PivotTo(CFrame.lookAt(Vector3.new(newPos.X, D + 0.3, newPos.Z), Vector3.new(target.X, D + 0.3, target.Z)))
		else
			enemy:PivotTo(CFrame.lookAt(Vector3.new(here.X, D + 0.3, here.Z), Vector3.new(target.X, D + 0.3, target.Z)))
		end

		if bestDist <= range and t - enemy:GetAttribute("LastAttack") >= enemy:GetAttribute("Cooldown") then
			enemy:SetAttribute("LastAttack", t)
			best.hum:TakeDamage(enemy:GetAttribute("Damage"))
			inCombat(best.plr)
			if enemy:GetAttribute("Kind") == "agent" then
				tracer(pos + Vector3.new(0, D, 0), tp, Color3.fromRGB(120, 200, 255), 0.3)
			end
		end
	end
end)
]]></ProtectedString></Properties></Item></Item><Item class="ReplicatedStorage" referent="RBX001273"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="ModuleScript" referent="RBX001265"><Properties><string name="Name">Morphs</string><ProtectedString name="Source"><![CDATA[-- Morphs (ModuleScript, ReplicatedStorage). Builds original morph models from parts.
local Morphs = {}

Morphs.List = {
	{Id = "SpiderCommode", Name = "Spider Commode", Price = 0, Require = "None", Level = 1, Health = 2500, Speed = 22, Damage = 1.0},
	{Id = "LensAgent", Name = "Lens Agent", Price = 0, Require = "None", Level = 1, Health = 3000, Speed = 20, Damage = 1.1},
	{Id = "AstroPlumber", Name = "Astro Plumber", Price = 60000, Require = "None", Level = 1, Health = 4500, Speed = 26, Damage = 1.4},
	{Id = "BassAgent", Name = "Bass Agent", Price = 150000, Require = "Level 3", Level = 3, Health = 8000, Speed = 18, Damage = 2.0},
	{Id = "TitanBasin", Name = "Titan Basin", Price = 1000000, Require = "Level 5", Level = 5, Health = 20000, Speed = 16, Damage = 3.5},
}

Morphs.ById = {}
for _, m in ipairs(Morphs.List) do
	Morphs.ById[m.Id] = m
end

local BLOCK, BALL, CYL = Enum.PartType.Block, Enum.PartType.Ball, Enum.PartType.Cylinder
local UPRIGHT = CFrame.Angles(0, 0, math.pi / 2) -- stand a cylinder on end
local FACEFWD = CFrame.Angles(0, math.pi / 2, 0) -- cylinder axis points along Z

local function newPart(parent, name, shape, size, color, cf, material)
	local p = Instance.new("Part")
	p.Name = name
	p.Shape = shape
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.CanCollide = false
	p.CanTouch = false
	p.Massless = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CFrame = cf
	p.Parent = parent
	return p
end

-- Weld whose pivot is a world point (so limbs swing around joints). Attributes drive the client animator.
local function joint(a, b, pivot, name, attrs)
	local w = Instance.new("Weld")
	w.Name = name
	w.Part0 = a
	w.Part1 = b
	w.C0 = a.CFrame:Inverse() * CFrame.new(pivot)
	w.C1 = b.CFrame:Inverse() * CFrame.new(pivot)
	if attrs then
		for k, v in pairs(attrs) do
			w:SetAttribute(k, v)
		end
	end
	w.Parent = a
	return w
end

local function fix(a, b, name)
	local w = Instance.new("Weld")
	w.Name = name or "Fix"
	w.Part0 = a
	w.Part1 = b
	w.C0 = a.CFrame:Inverse() * b.CFrame
	w.Parent = a
	return w
end

local function addFace(head)
	local d = Instance.new("Decal")
	d.Face = Enum.NormalId.Front
	d.Texture = "rbxasset://textures/face.png"
	d.Parent = head
end

-- ===== Spider-legged toilet =====
local function buildSpider(model, s, pal)
	local function V(x, y, z) return Vector3.new(x * s, y * s, z * s) end
	local D = 11 * s
	model:SetAttribute("GroundDrop", D)

	local body = newPart(model, "Body", CYL, V(3.2, 5.5, 5.5), pal.bowl, UPRIGHT)
	body.Material = Enum.Material.Concrete
	local function attach(name, shape, size, color, cf, material)
		local p = newPart(model, name, shape, size, color, cf, material)
		fix(body, p, "Fix_" .. name)
		return p
	end
	attach("Base", CYL, V(1.8, 3.4, 3.4), pal.trim, CFrame.new(0, -2.4 * s, 0) * UPRIGHT)
	attach("Rim", CYL, V(0.6, 5.9, 5.9), pal.rim, CFrame.new(0, 1.8 * s, 0) * UPRIGHT)
	attach("Tank", BLOCK, V(4.6, 4, 1.8), pal.bowl, CFrame.new(0, 1.2 * s, 2.5 * s), Enum.Material.Concrete)
	attach("Handle", BLOCK, V(0.8, 0.4, 0.6), pal.trim, CFrame.new(1.8 * s, 3.4 * s, 2.5 * s))
	local head = attach("Head", BALL, V(4.6, 4.6, 4.6), pal.skin, CFrame.new(0, 3.9 * s, -0.2 * s))
	addFace(head)
	attach("Hair", BLOCK, V(3.4, 0.5, 3.2), pal.hair, CFrame.new(0, 6.0 * s, -0.2 * s))

	-- machine gun hanging under the bowl
	local gun = attach("Gun", BLOCK, V(0.7, 0.7, 3.4), Color3.fromRGB(35, 35, 38), CFrame.new(0, -3.2 * s, -1.6 * s))
	local muzzle = Instance.new("Attachment")
	muzzle.Name = "Muzzle"
	muzzle.Position = Vector3.new(0, 0, -1.8 * s)
	muzzle.Parent = gun

	-- four long jointed legs
	local idx = 0
	for _, sx in ipairs({-1, 1}) do
		for _, sz in ipairs({-1, 1}) do
			idx += 1
			local hip = Vector3.new(sx * 2.4 * s, 0.8 * s, sz * 1.9 * s)
			local u = Vector3.new(sx * 0.8, 0.7, sz * 0.5).Unit
			local upLen = 7.5 * s
			local upCenter = hip + u * (upLen / 2)
			local upper = newPart(model, "LegUpper" .. idx, BLOCK, Vector3.new(0.45 * s, 0.45 * s, upLen), pal.leg, CFrame.lookAt(upCenter, upCenter + u))
			local knee = hip + u * upLen
			local d = Vector3.new(sx * 0.35, -1, sz * 0.25).Unit
			local lowLen = (knee.Y + D) / -d.Y
			local lowCenter = knee + d * (lowLen / 2)
			local lower = newPart(model, "LegLower" .. idx, BLOCK, Vector3.new(0.3 * s, 0.3 * s, lowLen), pal.leg, CFrame.lookAt(lowCenter, lowCenter + d))
			local tip = knee + d * lowLen
			local claw = newPart(model, "Claw" .. idx, BLOCK, Vector3.new(0.9 * s, 0.2 * s, 0.9 * s), pal.leg, CFrame.new(tip))
			joint(body, upper, hip, "Hip" .. idx, {Axis = "Y", Amp = 0.32, Phase = (idx - 1) * math.pi / 2, Rate = 1})
			joint(upper, lower, knee, "Knee" .. idx, {Axis = "X", Amp = 0.12, Phase = (idx - 1) * math.pi / 2 + 1, Rate = 1})
			fix(lower, claw, "FixClaw" .. idx)
		end
	end
	return body
end

-- ===== Humanoid base (agent / astronaut bodies) =====
local function buildHuman(model, s, c)
	local function V(x, y, z) return Vector3.new(x * s, y * s, z * s) end
	model:SetAttribute("GroundDrop", 5.25 * s)
	local body = newPart(model, "Body", BLOCK, V(3, 3.5, 1.8), c.suit, CFrame.new())
	for i, sx in ipairs({-1, 1}) do
		local pivot = Vector3.new(sx * 0.8 * s, -1.75 * s, 0)
		local leg = newPart(model, "Leg" .. i, BLOCK, V(1.3, 3.5, 1.4), c.pants or c.suit, CFrame.new(pivot + Vector3.new(0, -1.75 * s, 0)))
		joint(body, leg, pivot, "Hip" .. i, {Axis = "X", Amp = 0.7, Phase = (i == 1) and 0 or math.pi, Rate = 1})
		local shoe = newPart(model, "Shoe" .. i, BLOCK, V(1.4, 0.4, 1.8), c.shoe, CFrame.new(pivot + Vector3.new(0, -3.5 * s + 0.2 * s, -0.2 * s)))
		fix(leg, shoe, "FixShoe" .. i)
	end
	for i, sx in ipairs({-1, 1}) do
		local pivot = Vector3.new(sx * 2.05 * s, 1.4 * s, 0)
		local arm = newPart(model, "Arm" .. i, BLOCK, V(1.1, 3.2, 1.2), c.suit, CFrame.new(pivot + Vector3.new(0, -1.6 * s, 0)))
		joint(body, arm, pivot, "Shoulder" .. i, {Axis = "X", Amp = 0.6, Phase = (i == 1) and math.pi or 0, Rate = 1})
		local hand = newPart(model, "Hand" .. i, BLOCK, V(1, 0.9, 1.1), c.skin, CFrame.new(pivot + Vector3.new(0, -3.2 * s - 0.2 * s, 0)))
		fix(arm, hand, "FixHand" .. i)
	end
	return body
end

local function humanAttach(body, model, name, shape, size, color, cf, material)
	local p = newPart(model, name, shape, size, color, cf, material)
	fix(body, p, "Fix_" .. name)
	return p
end

local function buildLens(model, s, pal)
	local function V(x, y, z) return Vector3.new(x * s, y * s, z * s) end
	local body = buildHuman(model, s, {suit = pal.suit, skin = pal.skin, shoe = Color3.fromRGB(20, 20, 20)})
	humanAttach(body, model, "Tie", BLOCK, V(0.5, 1.8, 0.2), Color3.fromRGB(190, 30, 30), CFrame.new(0, 0.5 * s, -0.95 * s))
	local head = humanAttach(body, model, "Head", BLOCK, V(2.6, 2.6, 2.4), Color3.fromRGB(28, 28, 32), CFrame.new(0, 3.1 * s, 0))
	humanAttach(body, model, "LensRing", CYL, V(0.5, 1.9, 1.9), Color3.fromRGB(235, 235, 235), CFrame.new(0, 3.1 * s, -1.3 * s) * FACEFWD)
	humanAttach(body, model, "LensGlass", CYL, V(0.3, 1.3, 1.3), Color3.fromRGB(70, 160, 255), CFrame.new(0, 3.1 * s, -1.5 * s) * FACEFWD, Enum.Material.Neon)
	humanAttach(body, model, "Antenna", BLOCK, V(0.15, 1.2, 0.15), Color3.fromRGB(20, 20, 20), CFrame.new(0.8 * s, 4.9 * s, 0))
	local gun = humanAttach(body, model, "Gun", BLOCK, V(0.6, 0.6, 2.8), Color3.fromRGB(50, 50, 55), CFrame.new(-2.1 * s, -0.8 * s, -1.6 * s))
	local m = Instance.new("Attachment"); m.Name = "Muzzle"; m.Position = Vector3.new(0, 0, -1.5 * s); m.Parent = gun
	return head
end

local function buildBass(model, s, pal)
	local function V(x, y, z) return Vector3.new(x * s, y * s, z * s) end
	local body = buildHuman(model, s, {suit = pal.suit, skin = pal.skin, shoe = Color3.fromRGB(20, 20, 20)})
	humanAttach(body, model, "Shirt", BLOCK, V(1.2, 3.4, 0.2), Color3.fromRGB(235, 235, 235), CFrame.new(0, 0, -0.95 * s))
	humanAttach(body, model, "Head", BLOCK, V(3.4, 4.4, 2.4), Color3.fromRGB(25, 25, 28), CFrame.new(0, 3.8 * s, 0))
	humanAttach(body, model, "WooferRing", CYL, V(0.4, 2.2, 2.2), Color3.fromRGB(140, 140, 145), CFrame.new(0, 2.9 * s, -1.3 * s) * FACEFWD)
	humanAttach(body, model, "WooferCore", CYL, V(0.3, 1.2, 1.2), Color3.fromRGB(255, 120, 40), CFrame.new(0, 2.9 * s, -1.5 * s) * FACEFWD, Enum.Material.Neon)
	humanAttach(body, model, "TweeterRing", CYL, V(0.4, 1.2, 1.2), Color3.fromRGB(140, 140, 145), CFrame.new(0, 4.8 * s, -1.3 * s) * FACEFWD)
	humanAttach(body, model, "TweeterCore", CYL, V(0.3, 0.6, 0.6), Color3.fromRGB(255, 120, 40), CFrame.new(0, 4.8 * s, -1.5 * s) * FACEFWD, Enum.Material.Neon)
	local gun = humanAttach(body, model, "Gun", BLOCK, V(0.8, 0.8, 3.2), Color3.fromRGB(50, 50, 55), CFrame.new(2.3 * s, -0.8 * s, -1.8 * s))
	local m = Instance.new("Attachment"); m.Name = "Muzzle"; m.Position = Vector3.new(0, 0, -1.7 * s); m.Parent = gun
end

local function buildAstro(model, s, pal)
	local function V(x, y, z) return Vector3.new(x * s, y * s, z * s) end
	local body = buildHuman(model, s, {suit = Color3.fromRGB(240, 240, 245), skin = Color3.fromRGB(240, 240, 245), shoe = Color3.fromRGB(120, 120, 130)})
	local head = humanAttach(body, model, "Head", BALL, V(2.8, 2.8, 2.8), pal.skin, CFrame.new(0, 3.2 * s, 0))
	addFace(head)
	local helmet = humanAttach(body, model, "Helmet", BALL, V(4.4, 4.4, 4.4), Color3.fromRGB(170, 215, 255), CFrame.new(0, 3.2 * s, 0))
	helmet.Transparency = 0.6
	humanAttach(body, model, "Jetpack", BLOCK, V(2.4, 3, 1.2), Color3.fromRGB(70, 70, 78), CFrame.new(0, 0.2 * s, 1.5 * s))
	for _, sx in ipairs({-1, 1}) do
		humanAttach(body, model, "Thruster", CYL, V(0.9, 0.9, 0.9), Color3.fromRGB(255, 140, 40), CFrame.new(sx * 0.6 * s, -1.6 * s, 1.5 * s) * UPRIGHT, Enum.Material.Neon)
	end
	humanAttach(body, model, "Badge", BLOCK, V(0.7, 0.7, 0.1), Color3.fromRGB(50, 120, 255), CFrame.new(0.8 * s, 0.8 * s, -0.95 * s), Enum.Material.Neon)
	local gun = humanAttach(body, model, "Gun", BLOCK, V(0.6, 0.6, 2.6), Color3.fromRGB(60, 60, 68), CFrame.new(2.1 * s, -0.8 * s, -1.5 * s))
	local m = Instance.new("Attachment"); m.Name = "Muzzle"; m.Position = Vector3.new(0, 0, -1.4 * s); m.Parent = gun
end

local SPIDER_PAL = {
	bowl = Color3.fromRGB(232, 232, 226), rim = Color3.fromRGB(205, 205, 200), trim = Color3.fromRGB(150, 150, 150),
	skin = Color3.fromRGB(236, 196, 168), hair = Color3.fromRGB(150, 150, 150), leg = Color3.fromRGB(22, 22, 26),
}
local TITAN_PAL = {
	bowl = Color3.fromRGB(70, 70, 78), rim = Color3.fromRGB(212, 175, 55), trim = Color3.fromRGB(212, 175, 55),
	skin = Color3.fromRGB(200, 160, 135), hair = Color3.fromRGB(25, 25, 25), leg = Color3.fromRGB(212, 175, 55),
}

local function finish(model, body)
	model.PrimaryPart = body
	return model
end

function Morphs.Build(id, tint)
	local model = Instance.new("Model")
	model.Name = id
	local body
	if id == "SpiderCommode" then
		body = buildSpider(model, 1, SPIDER_PAL)
	elseif id == "TitanBasin" then
		body = buildSpider(model, 1.7, TITAN_PAL)
	elseif id == "LensAgent" then
		buildLens(model, 1, {suit = Color3.fromRGB(30, 30, 34), skin = Color3.fromRGB(235, 195, 165)})
		body = model.Body
	elseif id == "BassAgent" then
		buildBass(model, 1.25, {suit = Color3.fromRGB(26, 26, 30), skin = Color3.fromRGB(235, 195, 165)})
		body = model.Body
	elseif id == "AstroPlumber" then
		buildAstro(model, 1, {skin = Color3.fromRGB(236, 196, 168)})
		body = model.Body
	else
		error("Unknown morph " .. tostring(id))
	end
	if tint then
		for _, p in ipairs(model:GetChildren()) do
			if p:IsA("BasePart") and (p.Name == "Body" or p.Name == "Tank" or p.Name == "Leg1" or p.Name == "Leg2") then
				p.Color = tint
			end
		end
	end
	return finish(model, body)
end

-- Enemy models: scale variants of the spider toilet and an agent soldier
function Morphs.BuildEnemy(kind, scale, tint)
	local model = Instance.new("Model")
	model.Name = "Enemy"
	local body
	if kind == "spider" then
		local pal = table.clone(SPIDER_PAL)
		pal.bowl = tint or pal.bowl
		body = buildSpider(model, scale, pal)
	else
		buildLens(model, scale, {suit = tint or Color3.fromRGB(40, 40, 46), skin = Color3.fromRGB(235, 195, 165)})
		body = model.Body
	end
	return finish(model, body)
end

return Morphs
]]></ProtectedString></Properties></Item><Item class="RemoteEvent" referent="RBX001266"><Properties><string name="Name">FireGun</string></Properties></Item><Item class="RemoteEvent" referent="RBX001267"><Properties><string name="Name">Ability</string></Properties></Item><Item class="RemoteEvent" referent="RBX001268"><Properties><string name="Name">BuyMorph</string></Properties></Item><Item class="RemoteEvent" referent="RBX001269"><Properties><string name="Name">EquipMorph</string></Properties></Item><Item class="RemoteEvent" referent="RBX001270"><Properties><string name="Name">PlaceBlock</string></Properties></Item><Item class="RemoteEvent" referent="RBX001271"><Properties><string name="Name">Popup</string></Properties></Item><Item class="RemoteEvent" referent="RBX001272"><Properties><string name="Name">Notify</string></Properties></Item></Item><Item class="StarterPlayer" referent="RBX001280"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX001279"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX001274"><Properties><bool name="Disabled">false</bool><string name="Name">Animator</string><ProtectedString name="Source"><![CDATA[-- Animator (LocalScript). Animates every model tagged "Walker": legs, arms and spider legs swing with movement.
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")

local states = {}

local function register(model)
	if states[model] then return end
	local body = model.PrimaryPart or model:FindFirstChild("Body")
	if not body then return end
	local joints = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("Weld") and d:GetAttribute("Axis") then
			table.insert(joints, {
				weld = d,
				base = d.C0,
				axis = d:GetAttribute("Axis"),
				amp = d:GetAttribute("Amp") or 0.3,
				phase = d:GetAttribute("Phase") or 0,
				rate = d:GetAttribute("Rate") or 1,
			})
		end
	end
	if #joints == 0 then return end
	states[model] = {joints = joints, body = body, last = body.Position, t = math.random() * 6, speed = 0}
end

task.spawn(function()
	while true do
		for _, m in ipairs(CollectionService:GetTagged("Walker")) do
			if not states[m] and m:IsDescendantOf(workspace) then
				register(m)
			end
		end
		task.wait(0.5)
	end
end)

RunService.RenderStepped:Connect(function(dt)
	dt = math.max(dt, 1 / 240)
	for model, st in pairs(states) do
		if not model:IsDescendantOf(workspace) or not st.body.Parent then
			states[model] = nil
		else
			local pos = st.body.Position
			local v = (pos - st.last).Magnitude / dt
			st.last = pos
			local target = math.clamp(v / 18, 0, 1.6)
			st.speed += (target - st.speed) * math.min(1, dt * 6)
			st.t += dt * (2 + st.speed * 5)
			for _, j in ipairs(st.joints) do
				if j.weld.Parent then
					local a = math.sin(st.t * j.rate + j.phase) * j.amp * (0.07 + st.speed)
					local rot
					if j.axis == "X" then
						rot = CFrame.Angles(a, 0, 0)
					elseif j.axis == "Y" then
						rot = CFrame.Angles(0, a, 0)
					else
						rot = CFrame.Angles(0, 0, a)
					end
					j.weld.C0 = j.base * rot
				end
			end
		end
	end
end)
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX001275"><Properties><bool name="Disabled">false</bool><string name="Name">HUD</string><ProtectedString name="Source"><![CDATA[-- HUD (LocalScript): cash, menu buttons, level/xp, health, combat tag, hotbar, popups, notifications, stats/settings
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")

local player = Players.LocalPlayer
local Remotes = {
	Popup = RS:WaitForChild("Popup"),
	Notify = RS:WaitForChild("Notify"),
	Ability = RS:WaitForChild("Ability"),
}
local leaderstats = player:WaitForChild("leaderstats")
local dollars = leaderstats:WaitForChild("Dollars")
local kills = leaderstats:WaitForChild("Kills")
local gems = leaderstats:WaitForChild("Gems")

local FONT = Enum.Font.Garamond
local DARK = Color3.fromRGB(34, 38, 34)
local EDGE = Color3.fromRGB(90, 96, 90)

local function new(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do
		o[k] = v
	end
	if parent then o.Parent = parent end
	return o
end

local function fmt(n)
	local units = {"", "K", "M", "B", "T", "Q"}
	local i = 1
	while n >= 1000 and i < #units do
		n /= 1000
		i += 1
	end
	if i == 1 then return tostring(math.floor(n)) end
	return string.format("%.2f%s", n, units[i])
end

local function styled(frame, radius)
	new("UICorner", {CornerRadius = UDim.new(0, radius or 4)}, frame)
	new("UIStroke", {Color = EDGE, Thickness = 1.5}, frame)
	return frame
end

local gui = new("ScreenGui", {Name = "HUD", ResetOnSpawn = false, IgnoreGuiInset = false}, player:WaitForChild("PlayerGui"))
player:SetAttribute("Slot", 2)
player:SetAttribute("ShowNumbers", true)

-- ===== bottom-left cluster =====
local cluster = new("Frame", {Name = "Cluster", BackgroundTransparency = 1, Position = UDim2.new(0, 12, 1, -190), Size = UDim2.new(0, 330, 0, 178)}, gui)

local cash = styled(new("Frame", {BackgroundColor3 = DARK, Size = UDim2.new(0, 135, 0, 36)}, cluster))
new("Frame", {BackgroundColor3 = Color3.fromRGB(70, 170, 70), Size = UDim2.new(0, 30, 0, 22), Position = UDim2.new(0, 6, 0.5, -11), BorderSizePixel = 0}, cash)
local cashLabel = new("TextLabel", {BackgroundTransparency = 1, Position = UDim2.new(0, 40, 0, 0), Size = UDim2.new(1, -44, 1, 0), TextColor3 = Color3.new(1, 1, 1), Font = FONT, TextSize = 22, TextXAlignment = Enum.TextXAlignment.Left, Text = "0"}, cash)

local function barButton(text, x, y, w)
	local b = new("TextButton", {Text = text, Font = FONT, TextSize = 24, TextColor3 = Color3.new(1, 1, 1), BackgroundColor3 = DARK, Position = UDim2.new(0, x, 0, y), Size = UDim2.new(0, w, 0, 36)}, cluster)
	return styled(b)
end
local menuBtn = barButton("MENU", 141, 0, 189)
local settingsBtn = barButton("SETTINGS", 0, 42, 163)
local statsBtn = barButton("STATS", 167, 42, 163)

local levelBox = styled(new("TextLabel", {BackgroundColor3 = Color3.fromRGB(225, 150, 20), Size = UDim2.new(0, 36, 0, 30), Position = UDim2.new(0, 0, 0, 86), Font = FONT, TextSize = 22, TextColor3 = Color3.new(1, 1, 1), Text = "1"}, cluster), 2)
local xpBack = styled(new("Frame", {BackgroundColor3 = Color3.fromRGB(95, 70, 20), Size = UDim2.new(0, 290, 0, 30), Position = UDim2.new(0, 40, 0, 86)}, cluster), 2)
local xpFill = new("Frame", {BackgroundColor3 = Color3.fromRGB(235, 160, 25), Size = UDim2.new(1, 0, 1, 0), BorderSizePixel = 0}, xpBack)
local xpText = new("TextLabel", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Font = FONT, TextSize = 20, TextColor3 = Color3.new(1, 1, 1), Text = "0 / 100", ZIndex = 3}, xpBack)

local hpBack = styled(new("Frame", {BackgroundColor3 = Color3.fromRGB(20, 20, 20), Size = UDim2.new(0, 330, 0, 32), Position = UDim2.new(0, 0, 0, 124)}, cluster), 2)
local hpLag = new("Frame", {BackgroundColor3 = Color3.fromRGB(190, 30, 30), Size = UDim2.new(1, 0, 1, 0), BorderSizePixel = 0}, hpBack)
local hpFill = new("Frame", {BackgroundColor3 = Color3.fromRGB(60, 210, 40), Size = UDim2.new(1, 0, 1, 0), BorderSizePixel = 0, ZIndex = 2}, hpBack)
local hpText = new("TextLabel", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Font = FONT, TextSize = 22, TextColor3 = Color3.new(1, 1, 1), Text = "", ZIndex = 3}, hpBack)

local combat = new("TextLabel", {BackgroundTransparency = 1, Position = UDim2.new(0, 160, 1, -228), Size = UDim2.new(0, 180, 0, 30), Font = Enum.Font.Garamond, TextSize = 28, TextColor3 = Color3.fromRGB(210, 30, 30), Text = "IN COMBAT", Visible = false, TextStrokeTransparency = 0.4}, gui)

-- ===== hotbar =====
local slotInfo = {
	{name = "Building\nTools"},
	{name = "Machine\nGun"},
	{name = "Ultimate\nQuad-Lasers", cd = "CD_Quad", total = 18, ability = "Quad"},
	{name = "Titan\nAttack", cd = "CD_Titan", total = 10, ability = "Titan"},
}
local hotbar = new("Frame", {BackgroundTransparency = 1, Position = UDim2.new(0.5, -150, 1, -66), Size = UDim2.new(0, 300, 0, 56)}, gui)
local slotButtons, slotOverlays = {}, {}

local function selectSlot(i)
	local s = slotInfo[i]
	if s.ability then
		Remotes.Ability:FireServer(s.ability)
	else
		player:SetAttribute("Slot", i)
	end
end

for i, s in ipairs(slotInfo) do
	local b = styled(new("TextButton", {Text = s.name, Font = FONT, TextSize = 14, TextColor3 = Color3.new(1, 1, 1), BackgroundColor3 = DARK, Position = UDim2.new(0, (i - 1) * 76, 0, 0), Size = UDim2.new(0, 70, 1, 0)}, hotbar), 3)
	local overlay = new("TextLabel", {BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.35, Size = UDim2.new(1, 0, 1, 0), Text = "", TextColor3 = Color3.new(1, 1, 1), Font = FONT, TextSize = 24, Visible = false, ZIndex = 4}, b)
	new("TextLabel", {BackgroundTransparency = 1, Position = UDim2.new(0, 3, 0, 0), Size = UDim2.new(0, 14, 0, 14), Text = tostring(i), Font = FONT, TextSize = 14, TextColor3 = Color3.fromRGB(200, 200, 200), ZIndex = 5}, b)
	b.MouseButton1Click:Connect(function() selectSlot(i) end)
	slotButtons[i] = b
	slotOverlays[i] = overlay
end

UIS.InputBegan:Connect(function(input, gp)
	if gp then return end
	local map = {[Enum.KeyCode.One] = 1, [Enum.KeyCode.Two] = 2, [Enum.KeyCode.Three] = 3, [Enum.KeyCode.Four] = 4}
	local i = map[input.KeyCode]
	if i then selectSlot(i) end
end)

-- fire button for touch screens
if UIS.TouchEnabled then
	local fire = styled(new("TextButton", {Text = "FIRE", Font = FONT, TextSize = 26, TextColor3 = Color3.new(1, 1, 1), BackgroundColor3 = Color3.fromRGB(170, 40, 40), Position = UDim2.new(1, -190, 1, -170), Size = UDim2.new(0, 90, 0, 90)}, gui), 45)
	fire.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
			player:SetAttribute("Firing", true)
		end
	end)
	fire.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
			player:SetAttribute("Firing", false)
		end
	end)
end

-- ===== notification =====
local notice = new("TextLabel", {BackgroundTransparency = 1, Position = UDim2.new(0.5, -260, 0, 6), Size = UDim2.new(0, 520, 0, 26), Font = FONT, TextSize = 22, TextColor3 = Color3.new(1, 1, 1), Text = "", TextStrokeTransparency = 0.3}, gui)
local noticeToken = 0
Remotes.Notify.OnClientEvent:Connect(function(text)
	noticeToken += 1
	local my = noticeToken
	notice.Text = text
	notice.TextTransparency = 0
	notice.TextStrokeTransparency = 0.3
	task.delay(3, function()
		if my == noticeToken then
			TweenService:Create(notice, TweenInfo.new(0.6), {TextTransparency = 1, TextStrokeTransparency = 1}):Play()
		end
	end)
end)

-- ===== floating numbers =====
Remotes.Popup.OnClientEvent:Connect(function(pos, text, color)
	if not player:GetAttribute("ShowNumbers") then return end
	local anchor = Instance.new("Part")
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(0.1, 0.1, 0.1)
	anchor.Position = pos
	anchor.Parent = workspace
	local bb = new("BillboardGui", {Size = UDim2.new(0, 90, 0, 30), StudsOffset = Vector3.new(0, 0, 0), AlwaysOnTop = true, Adornee = anchor}, anchor)
	local label = new("TextLabel", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Text = text, TextColor3 = color, Font = Enum.Font.GothamBold, TextSize = 20, TextStrokeTransparency = 0.2}, bb)
	TweenService:Create(bb, TweenInfo.new(0.9), {StudsOffset = Vector3.new(math.random(-2, 2), 6, 0)}):Play()
	TweenService:Create(label, TweenInfo.new(0.9), {TextTransparency = 1, TextStrokeTransparency = 1}):Play()
	Debris:AddItem(anchor, 1)
end)

-- ===== stats and settings panels =====
local function makePanel(title, width, height)
	local f = styled(new("Frame", {BackgroundColor3 = DARK, BackgroundTransparency = 0.05, Position = UDim2.new(0.5, -width / 2, 0.5, -height / 2), Size = UDim2.new(0, width, 0, height), Visible = false, ZIndex = 10}, gui), 6)
	new("TextLabel", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 36), Text = title, Font = FONT, TextSize = 28, TextColor3 = Color3.new(1, 1, 1), ZIndex = 11}, f)
	local close = styled(new("TextButton", {Text = "Close", Font = FONT, TextSize = 22, TextColor3 = Color3.new(1, 1, 1), BackgroundColor3 = Color3.fromRGB(150, 35, 35), Position = UDim2.new(0.5, -60, 1, -44), Size = UDim2.new(0, 120, 0, 34), ZIndex = 11}, f), 4)
	close.MouseButton1Click:Connect(function() f.Visible = false end)
	return f
end

local statsPanel = makePanel("Stats", 340, 260)
local statsLabel = new("TextLabel", {BackgroundTransparency = 1, Position = UDim2.new(0, 20, 0, 44), Size = UDim2.new(1, -40, 1, -96), Font = FONT, TextSize = 24, TextColor3 = Color3.new(1, 1, 1), TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, Text = "", ZIndex = 11}, statsPanel)

local settingsPanel = makePanel("Settings", 340, 200)
local numToggle = styled(new("TextButton", {Text = "Damage numbers: ON", Font = FONT, TextSize = 24, TextColor3 = Color3.new(1, 1, 1), BackgroundColor3 = Color3.fromRGB(50, 90, 50), Position = UDim2.new(0.5, -140, 0, 60), Size = UDim2.new(0, 280, 0, 40), ZIndex = 11}, settingsPanel), 4)
numToggle.MouseButton1Click:Connect(function()
	local on = not player:GetAttribute("ShowNumbers")
	player:SetAttribute("ShowNumbers", on)
	numToggle.Text = "Damage numbers: " .. (on and "ON" or "OFF")
	numToggle.BackgroundColor3 = on and Color3.fromRGB(50, 90, 50) or Color3.fromRGB(90, 50, 50)
end)

statsBtn.MouseButton1Click:Connect(function() statsPanel.Visible = not statsPanel.Visible; settingsPanel.Visible = false end)
settingsBtn.MouseButton1Click:Connect(function() settingsPanel.Visible = not settingsPanel.Visible; statsPanel.Visible = false end)
menuBtn.MouseButton1Click:Connect(function()
	statsPanel.Visible = false
	settingsPanel.Visible = false
	player:SetAttribute("UI_Shop", true)
end)

-- ===== per-frame updates =====
local lag = 1
local joined = os.clock()
local statTimer = 0
RunService.RenderStepped:Connect(function(dt)
	cashLabel.Text = fmt(dollars.Value)

	local level = player:GetAttribute("Level") or 1
	local xp = player:GetAttribute("XP") or 0
	local need = 100 * level
	levelBox.Text = tostring(level)
	xpFill.Size = UDim2.new(math.clamp(xp / need, 0, 1), 0, 1, 0)
	xpText.Text = string.format("%d / %d", xp, need)

	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum and hum.MaxHealth > 0 then
		local ratio = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
		if ratio < lag then
			lag += (ratio - lag) * math.min(1, dt * 2)
		else
			lag = ratio
		end
		hpFill.Size = UDim2.new(ratio, 0, 1, 0)
		hpLag.Size = UDim2.new(lag, 0, 1, 0)
		hpText.Text = string.format("%d/%d", math.ceil(hum.Health), math.ceil(hum.MaxHealth))
	end

	combat.Visible = workspace:GetServerTimeNow() < (player:GetAttribute("CombatUntil") or 0)

	local slot = player:GetAttribute("Slot")
	for i, b in ipairs(slotButtons) do
		local stroke = b:FindFirstChildOfClass("UIStroke")
		stroke.Color = (i == slot) and Color3.fromRGB(80, 160, 255) or EDGE
		stroke.Thickness = (i == slot) and 3 or 1.5
		local s = slotInfo[i]
		if s.cd then
			local left = (player:GetAttribute(s.cd) or 0) - workspace:GetServerTimeNow()
			if left > 0 then
				slotOverlays[i].Visible = true
				slotOverlays[i].Text = string.format("%.0f", math.ceil(left))
			else
				slotOverlays[i].Visible = false
			end
		end
	end

	statTimer += dt
	if statTimer > 0.5 and statsPanel.Visible then
		statTimer = 0
		local mins = math.floor((os.clock() - joined) / 60)
		statsLabel.Text = string.format("Kills: %s\nGems: %s\nLevel: %d\nMorph: %s\nTime played: %d min", fmt(kills.Value), fmt(gems.Value), level, tostring(player:GetAttribute("Morph")), mins)
	end
end)
